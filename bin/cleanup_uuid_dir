#!/usr/bin/env bash
set -euo pipefail

DELETE=false
if [[ "${1:-}" == "--delete" ]]; then
    DELETE=true
fi

FOLDER="/scratch/${USER}/"

UUID_REGEX='./[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

echo "Scanning: ${FOLDER}"
echo "Matching UUID-named directories older than 15 days..."
echo

mapfile -d '' dirs < <(
    find $FOLDER \
        -mindepth 1 -maxdepth 1 \
        -type d \
        -regextype posix-extended \
        -regex "$UUID_REGEX" \
        -mtime +15 \
        -print0
)

if [[ ${#dirs[@]} -eq 0 ]]; then
    echo "No matching directories found."
    exit 0
fi

echo "Found ${#dirs[@]} directory(s):"
for d in "${dirs[@]}"; do
    printf '  %s\n' "$d"
done
echo

# --- SIZE CALCULATION ---
echo "Calculating total size..."

TOTAL_BYTES=$(du -sb "${dirs[@]}" 2>/dev/null | awk '{sum+=$1} END {print sum}')

# Convert to human readable
human_size=$(numfmt --to=iec --suffix=B "$TOTAL_BYTES")

echo "Total space to be freed: $human_size"
echo

if [[ "$DELETE" == false ]]; then
    echo "Dry run only. Nothing deleted."
    echo "Run with --delete to remove them."
    exit 0
fi

echo "Deleting..."
for d in "${dirs[@]}"; do
    rm -rf -- "$d"
    printf 'Deleted: %s\n' "$d"
done

echo
echo "Freed approximately: $human_size"
echo "Done."
