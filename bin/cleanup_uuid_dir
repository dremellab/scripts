#!/usr/bin/env bash
set -euo pipefail

DELETE=false
if [[ "${1:-}" == "--delete" ]]; then
    DELETE=true
fi

FOLDERS=(
    "/scratch/${USER}"
    "/scratch/${USER}/tmpdir"
)
UUID_BASENAME_REGEX='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

echo "Scanning:"
for folder in "${FOLDERS[@]}"; do
    printf '  %s\n' "$folder"
done
echo "Matching UUID-named directories older than 10 days..."
echo

dirs=()
for folder in "${FOLDERS[@]}"; do
    if [[ ! -d "$folder" ]]; then
        continue
    fi

    while IFS= read -r -d '' d; do
        base=$(basename "$d")
        if [[ $base =~ $UUID_BASENAME_REGEX ]]; then
            dirs+=("$d")
        fi
    done < <(
        find "$folder" \
            -mindepth 1 -maxdepth 1 \
            -type d \
            -mtime +10 \
            -print0
    )
done

if [[ ${#dirs[@]} -eq 0 ]]; then
    echo "No matching directories found."
    exit 0
fi

echo "Found ${#dirs[@]} directory(s):"
for d in "${dirs[@]}"; do
    printf '  %s\n' "$d"
done
echo

echo "Calculating total size..."
TOTAL_BYTES=$(du -sb -- "${dirs[@]}" 2>/dev/null | awk '{sum+=$1} END {print sum+0}')
human_size=$(numfmt --to=iec --suffix=B "$TOTAL_BYTES")

echo "Total space to be freed: $human_size"
echo

if [[ "$DELETE" == false ]]; then
    echo "Dry run only. Nothing deleted."
    echo "Run with --delete to remove them."
    exit 0
fi

echo "Deleting..."
for d in "${dirs[@]}"; do
    rm -rf -- "$d"
    printf 'Deleted: %s\n' "$d"
done

echo
echo "Freed approximately: $human_size"
echo "Done."
